{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Playdate: Build PDX",
      "type": "shell",
      "command": "\"${env:PLAYDATE_SDK_PATH}\\bin\\pdc\"",
      "args": [
        ".\\source",
        "builds\\game.pdx"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Playdate: Run",
      "type": "shell",
      "dependsOn": "Playdate: Build PDX",
      "command": "C:\\Windows\\System32\\tasklist.exe",   // 👈 full path here
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        }
      },
      "problemMatcher": [],
      "dependsOrder": "sequence"
    },
    {
      "label": "Playdate: Launch Simulator",
      "type": "shell",
      "dependsOn": "Playdate: Build PDX",
      "command": "\"${env:PLAYDATE_SDK_PATH}\\bin\\PlaydateSimulator.exe\"",
      "args": [
        "builds\\game.pdx"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        }
      },
      "problemMatcher": []
    }
  ]
}
